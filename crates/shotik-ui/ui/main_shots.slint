import { Theme } from "theme.slint";
import { Button, Card, Icon } from "fluent.slint";

export struct MainShot { id: string, thumbnail: image, badge: string, time: string, size: string, duration: string, kind: string, busy: bool, tips: [string] }
export struct MainCaptureButton { mode: string, label: string, shortcut: string, icon: string, tip: string, primary: bool, recording: bool, extent: float }

export component MainShotsPage inherits Rectangle {
    in property <[MainShot]> shots;
    in property <[MainCaptureButton]> captures;
    private property <length> gallery-top: capture-flow.y + capture-flow.height + 18px;
    in property <string> empty-title;
    in property <string> empty-body;
    callback capture(string);
    callback action(string, string);
    private property <int> columns: max(1, floor((self.width + 12px) / 232px));
    private property <length> item-width: (self.width - (columns - 1) * 12px) / columns;
    private property <length> item-height: item-width * 10 / 16 + 33px;
    height: shots.length == 0 ? gallery-top + 325px : gallery-top + ceil(shots.length / columns) * (item-height + 12px) - 12px;
    capture-flow := FlexboxLayout {
        x: 0px; y: 42px; width: parent.width; height: self.preferred-height;
        spacing: 8px; alignment: start; cross-axis-alignment: start; cross-axis-line-alignment: start;
        for button in root.captures: Button {
            min-width: max(button.extent * 1px,self.preferred-width); max-width: self.min-width;
            text: button.label; icon: button.icon; shortcut: button.shortcut; tip: button.tip;
            primary: button.primary; danger: button.recording; ghost: button.mode == "folder";
            clicked => { root.capture(button.mode); }
        }
    }
    for item[i] in root.shots: Card {
        x: mod(i, root.columns) * (root.item-width + 12px); y: root.gallery-top + floor(i / root.columns) * (root.item-height + 12px);
        width: root.item-width; height: root.item-height; clip: true;
        Rectangle {
            x: 0px; y: 0px; width: parent.width; height: parent.width * 10 / 16; background: Theme.main-code;
            open := TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height;
                mouse-cursor: pointer; clicked => { root.action(item.id, "open"); }
                Image { width: 100%; height: 100%; source: item.thumbnail; image-fit: cover; }
                if item.kind == "audio": Icon { x: parent.width * 0.35; y: parent.height * 0.35; width: parent.width * 0.3; height: parent.height * 0.3; name: "audio"; ink: Theme.main-stroke-strong; }
                Rectangle { x: 8px; y: 8px; height: 20px; width: badge.preferred-width + 14px; border-radius: 4px; background: #141414b3;
                    badge := Text { text: item.badge; color: #f0f0f0; font-size: 10.5px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                }
                if item.kind == "video" || item.kind == "audio": Rectangle {
                    x: item.kind == "audio" ? 8px : (parent.width - self.width) / 2;
                    y: item.kind == "audio" ? parent.height - 40px : (parent.height - self.height) / 2;
                    width: item.kind == "audio" ? 32px : 44px; height: self.width; border-radius: self.width / 2;
                    background: open.has-hover ? Theme.accent : #141418b3; border-width: 1px; border-color: #ffffff40;
                    Icon { x: parent.width * 0.3; y: parent.height * 0.3; width: parent.width * 0.4; height: parent.height * 0.4; name: "open"; ink: white; }
                }
                if item.duration != "": Rectangle { x: parent.width - self.width - 8px; y: parent.height - 28px; width: dur.preferred-width + 12px; height: 20px; border-radius: 4px; background: #0a0a0ec7;
                    dur := Text { text: item.duration; color: #f0f0f0; font-size: 11px; font-family: "Cascadia Mono"; horizontal-alignment: center; vertical-alignment: center; }
                }
                actions := Rectangle {
                    y: parent.height - 45px; width: parent.width; height: 45px;
                    opacity: open.has-hover ? 1 : 0;
                    background: #0a0a0ac7;
                    HorizontalLayout { padding: 8px; spacing: 4px; alignment: center;
                        for op[oi] in (item.kind == "audio" ? ["open", "path", "folder", "remove", "", ""] : item.kind == "video" ? ["open", "gif", "path", "folder", "remove", ""] : ["copy", "path", "pin", "ocr", "folder", "remove"]): Rectangle {
                            visible: op != ""; width: op != "" ? 29px : 0px; height: 29px; border-radius: 5px;
                            background: action-hit.has-hover ? (op == "remove" ? #c42b1c : Theme.accent) : #1c1c1ce6;
                            opacity: item.busy && (op == "gif" || op == "ocr") ? 0.4 : 1;
                            forward-focus: action-focus;
                            accessible-role: button; accessible-label: item.tips[oi];
                            accessible-action-default => { root.action(item.id, op); }
                            Icon { x: 7px; y: 7px; width: 14px; height: 14px; name: op; ink: action-hit.has-hover ? Theme.accent-text : #e3e3e3; }
                            action-focus := FocusScope { x: 0px; y: 0px; width: parent.width; height: parent.height;
                                key-pressed(event) => { if event.text == " " || event.text == "\n" { root.action(item.id, op); return accept; } return reject; }
                            }
                            action-hit := TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; mouse-cursor: pointer; clicked => { action-focus.focus(); root.action(item.id, op); } }
                            if action-hit.has-hover: Rectangle {
                                x: (parent.width - self.width) / 2; y: -28px; width: action-tip.preferred-width + 14px; height: 24px;
                                border-radius: 5px; background: Theme.window-bg; border-width: 1px; border-color: Theme.main-stroke-strong;
                                action-tip := Text { text: item.tips[oi]; color: Theme.text; font-size: 11.5px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }
        }
        Text { x: 12px; y: parent.height - 33px; height: 33px; width: parent.width - 110px; text: item.time; color: Theme.text-secondary; font-size: 12px; vertical-alignment: center; overflow: elide; }
        Text { x: parent.width - 100px; y: parent.height - 33px; height: 33px; width: 88px; text: item.size; color: Theme.text-tertiary; font-size: 11px; font-family: "Cascadia Mono"; horizontal-alignment: right; vertical-alignment: center; }
        // Rectangle clipping in the software renderer is rectangular; mask just the top corners.
        for corner in [0,1]: Path {
            x: corner == 0 ? 0px : parent.width - 8px; y: 0px; width: 8px; height: 8px;
            viewbox-width: 8; viewbox-height: 8; fill: Theme.window-bg;
            commands: corner == 0 ? "M0 0 H8 A8 8 0 0 0 0 8 Z" : "M0 0 H8 V8 A8 8 0 0 0 0 0 Z";
        }
    }
    if root.shots.length == 0: Rectangle {
        y: root.gallery-top + 90px; height: 190px; width: parent.width;
        Card { x: (parent.width - 72px) / 2; y: 0px; width: 72px; height: 72px; border-radius: 18px;
            Icon { x: 20px; y: 20px; width: 32px; height: 32px; name: "region"; ink: Theme.text-tertiary; }
        }
        Text { y: 92px; height: 24px; width: parent.width; text: root.empty-title; color: Theme.text; font-size: 16px; font-weight: 600; horizontal-alignment: center; }
        Text { y: 124px; height: 50px; width: parent.width; text: root.empty-body; color: Theme.text-secondary; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
    }
}
