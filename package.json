{
  "name": "shotik",
  "productName": "Shotik",
  "version": "0.5.7",
  "description": "Beautiful open-source screenshot tool with built-in MCP server — let Claude see your screen",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": "Shotik contributors",
  "homepage": "https://github.com/gorka2354/shotik",
  "repository": {
    "type": "git",
    "url": "https://github.com/gorka2354/shotik.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win",
    "dist:store": "electron-builder --win appx"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "dev.shotik.app",
    "productName": "Shotik",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "src/main/ocr.ps1",
      "src/main/windows-enum.ps1",
      "src/main/ocr-mac.js"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "Shotik-Setup-${version}.exe",
      "shortcutName": "Shotik",
      "include": "build/installer.nsh"
    },
    "appx": {
      "applicationId": "Shotik",
      "identityName": "REPLACE.WithIdentityFromPartnerCenter",
      "publisher": "CN=REPLACE-WITH-PUBLISHER-ID-FROM-PARTNER-CENTER",
      "publisherDisplayName": "gorka2354",
      "backgroundColor": "#202020",
      "languages": [
        "en-US",
        "ru-RU"
      ]
    },
    "portable": {
      "artifactName": "Shotik-${version}-portable.exe"
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "Shotik-${version}-${arch}.dmg"
    },
    "publish": {
      "provider": "github",
      "owner": "gorka2354",
      "repo": "shotik"
    }
  },
  "dependencies": {
    "gifenc": "^1.0.3"
  }
}
